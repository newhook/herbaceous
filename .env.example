# Auth.js secret — used to sign session JWTs. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=

# Vercel Postgres / Neon connection string.
# In Vercel: add a Postgres store and these are injected automatically.
# Locally: run `vercel env pull .env.local` after linking the project.
POSTGRES_URL=

# Customer.io CDP browser write key (Data Pipelines JavaScript source).
# Public by design — safe to expose to the browser. Keep sandbox and
# production keys separate. Find under: Customer.io → Data Pipelines →
# Sources → your JavaScript source → API keys.
NEXT_PUBLIC_CIO_CDP_WRITE_KEY=

# Customer.io App API key — BACKEND ONLY. Used for transactional sends (the
# signup welcome email). Workspace-scoped; never expose to the browser (no
# NEXT_PUBLIC prefix). Find under: Customer.io → Settings → API Credentials →
# App API Keys.
CIO_APP_API_KEY=
# App API base URL. US: https://api.customer.io  EU: https://api-eu.customer.io
CIO_APP_API_BASE_URL=https://api.customer.io
